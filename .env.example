# Variable names for local use. Leave secrets blank in this file.
# PayPilot loads a gitignored .env only for variables that are not already set.
# For SANDBOX, inject PAYPAL_CLIENT_ID and PAYPAL_CLIENT_SECRET into the
# process environment. Do not commit them, and do not paste them into docs,
# logs, or footage. MOCK is the default and is not a PayPal sandbox call.

# mock (default, no network) or sandbox (api-m.sandbox.paypal.com only)
PAYPILOT_PAYPAL_MODE=mock

# mock (default, deterministic parser) or openai (OpenAI-compatible chat completions)
PAYPILOT_INTENT_PROVIDER=mock

# Sandbox REST app credentials. Required only when PAYPILOT_PAYPAL_MODE=sandbox.
# Create them at https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Must stay on the sandbox host. Live hosts are refused.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Sandbox business account identity. Email is optional; omit it to let PayPal
# use the merchant on the REST app. A mismatched email often returns 422.
PAYPAL_INVOICER_EMAIL=
PAYPAL_INVOICER_GIVEN_NAME=PayPilot
PAYPAL_INVOICER_SURNAME=Merchant
PAYPAL_INVOICER_BUSINESS_NAME=PayPilot Demo

# Optional return URL for payment links. Leave blank to omit the field.
PAYPILOT_RETURN_URL=

# Intent provider "openai". Loopback base URLs may omit the API key (Ollama).
# Any other host requires OPENAI_API_KEY. Example local Ollama:
#   OPENAI_BASE_URL=http://127.0.0.1:11434/v1
#   OPENAI_MODEL=qwen2.5:3b
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Local SQLite file. Created on startup. Not a source of payment truth in sandbox mode.
PAYPILOT_DB=data/paypilot.sqlite

# Loopback port for `make serve`.
PAYPILOT_PORT=8765

# POST /api rate limit per session per minute. 0 disables the limit.
PAYPILOT_RATE_LIMIT_PER_MINUTE=60
